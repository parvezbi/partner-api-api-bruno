meta {
  name: Partner Revenue Analysis Report
  type: http
  seq: 4
}

get {
  url: {{base_url}}/partner/revenue/report
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

